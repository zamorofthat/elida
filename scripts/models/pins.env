# Single source of truth for the injection model pins.
#
# Read by scripts/models/{fetch,build,verify}.sh, the Makefile,
# scripts/docker-push.sh, the Dockerfile's model-builder stage, the CI and
# release workflows, internal/decision/embedded/hugot_test.go and
# test/unit/model_pins_test.go. Format: KEY=value, one per line, no quotes
# and no spaces, so the same file works for bash `source`, make `include`
# and $GITHUB_ENV. Changing any value is a model change and needs review.

# Upstream StackOne Defender commit the model is built from. fetch.sh
# refuses any other DEFENDER_COMMIT.
PINNED_DEFENDER_COMMIT=ff83e70981099f9261520e0e9bc6cb85bb9789da

# sha256 of the float32 model.onnx that the commit above, scripts/models/
# and onnx 1.23.1 / numpy 2.5.3 produce.
MODEL_ONNX_SHA256=13febddd90418e64b9285543f31a92534f778cb43ca728b33e46b2dba8848f6a

# sha256 of the built manifest.json. The manifest records a sha256 for
# every other shipped file, so this pins the whole artifact: any change to
# the model card, the tokenizer, the configs or the graph changes it.
# build.sh prints the new value when it does not match.
MANIFEST_SHA256=f4c52881cc5d4f85636a8c098865f291d4a5a29e992411d75579a3f8aea9bae4
