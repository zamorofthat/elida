# ELIDA Environment Variables Example
# Copy this to .env and fill in your values

# API Keys for backends
# These are automatically loaded for backends of the corresponding type
# (when backend config has no explicit api_key).
# You can also use backend-specific keys: <NAME>_API_KEY (e.g., NEMOTRON_API_KEY)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=

# Environment variable expansion in config
# YAML values support ${VAR} expansion (e.g., url: "${BACKEND_URL}").
# Unset variables are left literal (as ${VAR}) with a warning.

# TLS Configuration (for HTTPS)
# ELIDA_TLS_ENABLED=true
# ELIDA_TLS_CERT_FILE=/path/to/cert.pem
# ELIDA_TLS_KEY_FILE=/path/to/key.pem
# ELIDA_TLS_AUTO_CERT=true  # Development only

# Redis (for horizontal scaling)
# ELIDA_SESSION_STORE=redis
# ELIDA_REDIS_ADDR=localhost:6379
# ELIDA_REDIS_PASSWORD=

# Telemetry (OpenTelemetry)
# ELIDA_TELEMETRY_ENABLED=true
# ELIDA_TELEMETRY_EXPORTER=otlp
# ELIDA_TELEMETRY_ENDPOINT=localhost:4317

# Storage (SQLite for dashboard history)
# ELIDA_STORAGE_ENABLED=true
# ELIDA_STORAGE_PATH=data/elida.db

# Policy engine (for flagging suspicious sessions)
# ELIDA_POLICY_ENABLED=true

# Semantic injection detection — restart-required keys only.
# Runtime-editable keys (mode, thresholds, budgets) are set in settings.yaml
# or the dashboard, not here.
# ELIDA_DECISION_ENABLED=true
# ELIDA_DECISION_REQUIRED=true
# Fail startup unless the capability is inline (linux/amd64 + GOEXPERIMENT=simd)
# ELIDA_DECISION_REQUIRE_INLINE=true
# ELIDA_DECISION_PROVIDER=embedded
# ELIDA_DECISION_MODEL_PATH=/etc/elida/models/injection
# ELIDA_DECISION_ENDPOINT=https://decide.internal/v1/score
